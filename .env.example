# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Use um segredo aleatório longo, diferente do client secret do Google.
GOOGLE_OAUTH_SESSION_SECRET=replace-with-a-long-random-string
